---
output_file_name: manifest.mpd
revision: 1
---
ffmpeg -i "{{ input_file }}" -y
    -nostats -progress pipe:1
    -vf "pad=ceil(max(iw\,ih*16/9)/2)*2:ceil(max(ih\,iw*9/16)/2)*2:(ow-iw)/2:(oh-ih)/2,setsar=1,scale=-2:min(360\,ih)"
    -map 0:v:0 -c:v libvpx-vp9 -crf 36 -b:v 600k -deadline realtime -cpu-used 8
    {% if has_audio %}-map 0:a:0{% if loudness and loudness.truepeak_lufs is not none %} -af "loudnorm=I=-16:TP=-1:LRA=11:measured_I={{ loudness.integrated_lufs }}:measured_TP={{ loudness.truepeak_lufs }}:measured_LRA={{ loudness.loudness_range }}:measured_thresh={{ loudness.threshold_lufs }}:offset={{ loudness.target_offset }}:linear=true" -ar 48000{% endif %} -c:a aac -b:a 96k{% endif %}
    -row-mt 1 -pix_fmt yuv420p
    -fps_mode cfr -r {{ frame_rate }} -g {{ gop_frames }} -keyint_min {{ gop_frames }}
    -f dash -dash_segment_type mp4 -single_file 1 -seg_duration {{ segment_duration_s }}
    -adaptation_sets "id=0,streams=v{% if has_audio %} id=1,streams=a{% endif %}"
    "{{ output_file }}"

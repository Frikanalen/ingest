---
output_file_name: manifest.mpd
revision: 2
---
{% import "_ladder.j2" as ladder with context %}
ffmpeg -i "{{ input_file }}" -y
    -nostats -progress pipe:1
    -vf "{{ ladder.prepare() }},scale=-2:min(360\,ih),format=yuv420p"
    -map 0:v:0 -c:v libx264 -preset veryfast -profile:v high -b:v 800k -maxrate 1200k -bufsize 1600k
    {{ ladder.audio("96k") }}
    {{ ladder.gop() }}
    {{ ladder.dash("id=0,streams=v", audio_set=1) }}

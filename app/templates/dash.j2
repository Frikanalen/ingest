---
output_file_name: manifest.mpd
---
ffmpeg -i "{{ input_file }}" -y
    -nostats -progress pipe:1
    -filter_complex "[0:v]pad=ceil(max(iw\,ih*16/9)/2)*2:ceil(max(ih\,iw*9/16)/2)*2:(ow-iw)/2:(oh-ih)/2,setsar=1,split=3[hi][mid][low];[hi]scale=-2:min(1080\,ih)[v0];[mid]scale=-2:min(720\,ih)[v1];[low]scale=-2:min(360\,ih)[v2]"
    -map "[v0]" -c:v:0 libvpx-vp9 -crf:v:0 29 -b:v:0 5000k
    -map "[v1]" -c:v:1 libvpx-vp9 -crf:v:1 31 -b:v:1 2500k
    -map "[v2]" -c:v:2 libvpx-vp9 -crf:v:2 36 -b:v:2 600k
    {% if has_audio %}-map 0:a:0{% if loudness and loudness.truepeak_lufs is not none %} -af "loudnorm=I=-16:TP=-1:LRA=11:measured_I={{ loudness.integrated_lufs }}:measured_TP={{ loudness.truepeak_lufs }}:measured_LRA={{ loudness.loudness_range }}:measured_thresh={{ loudness.threshold_lufs }}:offset={{ loudness.target_offset }}:linear=true" -ar 48000{% endif %} -c:a aac -b:a 128k{% endif %}
    -cpu-used 3 -row-mt 1 -tile-columns 2 -pix_fmt yuv420p
    -fps_mode cfr -r {{ frame_rate }} -g {{ gop_frames }} -keyint_min {{ gop_frames }}
    -f dash -dash_segment_type mp4 -single_file 1 -seg_duration {{ segment_duration_s }}
    -adaptation_sets "id=0,streams=v{% if has_audio %} id=1,streams=a{% endif %}"
    "{{ output_file }}"

---
output_file_name: manifest.mpd
revision: 2
---
{% if has_audio and loudness and loudness.truepeak_lufs is not none %}{% set loudnorm = "loudnorm=I=-16:TP=-1:LRA=11:measured_I=" ~ loudness.integrated_lufs ~ ":measured_TP=" ~ loudness.truepeak_lufs ~ ":measured_LRA=" ~ loudness.loudness_range ~ ":measured_thresh=" ~ loudness.threshold_lufs ~ ":offset=" ~ loudness.target_offset ~ ":linear=true" %}{% endif %}
ffmpeg -i "{{ input_file }}" -y
    -nostats -progress pipe:1
    -filter_complex "[0:v]pad=ceil(max(iw\,ih*16/9)/2)*2:ceil(max(ih\,iw*9/16)/2)*2:(ow-iw)/2:(oh-ih)/2,setsar=1,split=3[hi][mid][low];[hi]scale=-2:min(1080\,ih)[v0];[mid]scale=-2:min(720\,ih),split=2[v1][v3];[low]scale=-2:min(360\,ih)[v2]"
    -map "[v0]" -c:v:0 libsvtav1 -preset:v:0 6 -crf:v:0 32 -b:v:0 0 -maxrate:v:0 3200k -bufsize:v:0 6400k -svtav1-params:v:0 lp=2
    -map "[v1]" -c:v:1 libsvtav1 -preset:v:1 6 -crf:v:1 33 -b:v:1 0 -maxrate:v:1 1600k -bufsize:v:1 3200k -svtav1-params:v:1 lp=2
    -map "[v2]" -c:v:2 libsvtav1 -preset:v:2 6 -crf:v:2 36 -b:v:2 0 -maxrate:v:2 450k -bufsize:v:2 900k -svtav1-params:v:2 lp=2
    -map "[v3]" -c:v:3 libvpx-vp9 -crf:v:3 31 -b:v:3 2500k -cpu-used:v:3 3 -row-mt:v:3 1 -tile-columns:v:3 2
    {% if has_audio %}-map 0:a:0 -c:a:0 libopus -b:a:0 128k{% if loudnorm %} -filter:a:0 "{{ loudnorm }}"{% endif %} -ar:a:0 48000{% endif %}
    {% if has_audio %}-map 0:a:0 -c:a:1 aac -b:a:1 128k{% if loudnorm %} -filter:a:1 "{{ loudnorm }}" -ar:a:1 48000{% endif %}{% endif %}
    -pix_fmt yuv420p
    -fps_mode cfr -r {{ frame_rate }} -g {{ gop_frames }} -keyint_min {{ gop_frames }}
    -f dash -dash_segment_type mp4 -single_file 1 -seg_duration {{ segment_duration_s }}
    -adaptation_sets "id=0,streams=0,1,2 id=1,streams=3{% if has_audio %} id=2,streams=4 id=3,streams=5{% endif %}"
    "{{ output_file }}"

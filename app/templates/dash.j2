---
output_file_name: manifest.mpd
revision: 3
---
{% if has_audio and loudness and loudness.truepeak_lufs is not none %}{% set loudnorm = "loudnorm=I=-16:TP=-1:LRA=11:measured_I=" ~ loudness.integrated_lufs ~ ":measured_TP=" ~ loudness.truepeak_lufs ~ ":measured_LRA=" ~ loudness.loudness_range ~ ":measured_thresh=" ~ loudness.threshold_lufs ~ ":offset=" ~ loudness.target_offset ~ ":linear=true" %}{% endif %}
ffmpeg -hwaccel cuda -hwaccel_output_format cuda -i "{{ input_file }}" -y
    -nostats -progress pipe:1
    -filter_complex "[0:v]pad_cuda=ceil(max(iw\,ih*16/9)/2)*2:ceil(max(ih\,iw*9/16)/2)*2:(ow-iw)/2:(oh-ih)/2,setsar=1,split=3[hi][mid][low];[hi]scale_cuda=-2:min(1080\,ih)[v0];[mid]scale_cuda=-2:min(720\,ih),split=2[v1][cpu];[low]scale_cuda=-2:min(360\,ih)[v2];[cpu]hwdownload,format=nv12,format=yuv420p[v3]"
    -map "[v0]" -c:v:0 av1_nvenc -preset:v:0 p7 -tune:v:0 uhq -rc:v:0 vbr -cq:v:0 28 -b:v:0 0 -maxrate:v:0 4500k -bufsize:v:0 9000k
    -map "[v1]" -c:v:1 av1_nvenc -preset:v:1 p7 -tune:v:1 uhq -rc:v:1 vbr -cq:v:1 30 -b:v:1 0 -maxrate:v:1 2200k -bufsize:v:1 4400k
    -map "[v2]" -c:v:2 av1_nvenc -preset:v:2 p7 -tune:v:2 uhq -rc:v:2 vbr -cq:v:2 34 -b:v:2 0 -maxrate:v:2 700k -bufsize:v:2 1400k
    -map "[v3]" -c:v:3 libvpx-vp9 -crf:v:3 31 -b:v:3 2500k -cpu-used:v:3 3 -row-mt:v:3 1 -tile-columns:v:3 2 -pix_fmt:v:3 yuv420p
    {% if has_audio %}-map 0:a:0 -c:a:0 libopus -b:a:0 128k{% if loudnorm %} -filter:a:0 "{{ loudnorm }}"{% endif %} -ar:a:0 48000{% endif %}
    {% if has_audio %}-map 0:a:0 -c:a:1 aac -b:a:1 128k{% if loudnorm %} -filter:a:1 "{{ loudnorm }}" -ar:a:1 48000{% endif %}{% endif %}
    -multipass:v:0 fullres -multipass:v:1 fullres -multipass:v:2 fullres
    -spatial-aq:v:0 1 -spatial-aq:v:1 1 -spatial-aq:v:2 1
    -rc-lookahead:v:0 32 -rc-lookahead:v:1 32 -rc-lookahead:v:2 32
    -no-scenecut:v:0 1 -no-scenecut:v:1 1 -no-scenecut:v:2 1
    -strict_gop:v:0 1 -strict_gop:v:1 1 -strict_gop:v:2 1
    -fps_mode cfr -r {{ frame_rate }} -g {{ gop_frames }} -keyint_min {{ gop_frames }}
    -f dash -dash_segment_type mp4 -single_file 1 -seg_duration {{ segment_duration_s }}
    -adaptation_sets "id=0,streams=0,1,2 id=1,streams=3{% if has_audio %} id=2,streams=4 id=3,streams=5{% endif %}"
    "{{ output_file }}"

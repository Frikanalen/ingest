# /etc/sudoers.d/fk-archive-utils -- install with mode 0440, root:root, and
# always through `visudo -c -f` first.
#
# The ingest account may run the three mutations against its own archive and
# nothing else. The profile name is matched literally, so the staging key
# cannot reach production's archive however it is invoked -- which is the
# whole reason the archive root is a profile lookup rather than an argument.
#
# fk-archive-purge-trash is deliberately absent. It is the only command in the
# package that deletes anything, and leaving it out of these rules is what
# lets them end in a wildcard.

# env_reset is Debian's default; restated per command because these are Python
# programs run through sudo, and PYTHONPATH or PYTHONSTARTUP surviving the
# transition would be a way to run other code as the archive account.
Defaults!/usr/bin/fk-archive env_reset, secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ingest         ALL=(archive-manager)         NOPASSWD: /usr/bin/fk-archive prod *
ingest-staging ALL=(archive-manager-staging) NOPASSWD: /usr/bin/fk-archive staging *
